{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "bartoszgrabski-dev",
    "compatibility_date": "2026-05-22",
    "main": "worker/index.ts",
    "assets": {
      "directory": "./out",
      "not_found_handling": "404-page",
      "run_worker_first": ["/api/*"]
    },
    "send_email": [
      { "name": "EMAIL" }
    ]
}
